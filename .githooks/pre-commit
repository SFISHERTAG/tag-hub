#!/bin/sh
# tag-agent-hooks v2 — installed into .git/hooks by scripts/install-hooks.mjs.
# Edit this file, not the installed copy, then run: npm run hooks:install
#
# Supersedes scripts/hooks/pre-commit, which was installed via core.hooksPath —
# an approach this repo's worktree config silently defeats (see the header of
# scripts/install-hooks.mjs). This file is the union of both: the isolation
# check the new hook introduced, plus every check the old hook already ran.
# Dropping role-parity or the Angular gate here would remove a gate nobody
# would notice was gone, which is the failure mode both hooks exist to prevent.
#
# v1 tried to honour that by guarding each check with `if [ -f <script> ]`, so
# that checking out a branch predating a check did not break committing on it.
# That guard caused the exact failure it was written to prevent: on a branch
# that had drifted and lost scripts/, all three checks skipped silently and the
# branch looked healthy through two weeks of commits.
#
# v2 keeps the old-branch case working without the blind spot, by asking *why*
# a script is absent. package.json is this branch's own manifest of which
# checks it expects:
#
#   declared in package.json + script present -> run it
#   declared in package.json + script MISSING -> hard fail; the tree
#       contradicts its own config, which means a stale or partial branch
#   not declared + script present             -> run it anyway
#   not declared + script absent              -> skip; this branch genuinely
#       predates the check, which is the case the v1 guard existed for
#
# The drift test is inline rather than in its own script on purpose: a check
# that can go missing independently of this hook reopens the blind spot.

# run_check <package.json script key> <script path>
run_check() {
  key="$1"
  script="$2"

  if grep -q "\"${key}\"" package.json 2>/dev/null; then
    if [ ! -f "${script}" ]; then
      echo "" >&2
      echo "pre-commit: BRANCH DRIFT — refusing to commit." >&2
      echo "" >&2
      echo "  package.json declares \"${key}\", but ${script} is missing." >&2
      echo "  branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null)" >&2
      echo "" >&2
      echo "  This tree contradicts its own config, which means it is a stale or" >&2
      echo "  partial branch — the checks you think are running are not running." >&2
      echo "  Do not commit through this; the guardrails are off." >&2
      echo "" >&2
      echo "  Fix by catching the branch up:  git merge origin/main" >&2
      echo "" >&2
      exit 1
    fi
    node "${script}" || exit 1
  elif [ -f "${script}" ]; then
    node "${script}" || exit 1
  fi
}

# Ownership of main, checked first: if this session should not be writing to
# main at all, none of the other gates matter. Note that git does NOT run this
# hook for a merge — .githooks/pre-merge-commit and .githooks/pre-push cover
# the two paths that never come through here, and the merge path is the one
# that actually moved main on 2026-08-23.
# Reachability runs FIRST because it is the cheapest and because a commit that
# lands where nothing can reach it is not fixed by any later check passing.
# Added 2026-08-27. It was written into scripts/hooks/pre-commit, which
# core.hooksPath does not point at, so from the day it landed it ran on no
# commit and in no CI job. Its own commit message said it "runs first in
# pre-commit, being the cheapest check". That was false as landed.
run_check "check:reachability"     scripts/check-commit-reachability.mjs
run_check "check:main-ownership"   scripts/check-main-ownership.mjs
run_check "check:agent-isolation" scripts/check-agent-isolation.mjs
run_check "check:branch-freshness"  scripts/check-branch-freshness.mjs
run_check "check:secret-scan"      scripts/check-secret-scan.mjs
run_check "check:story-status"    scripts/check-story-status.mjs
run_check "check:story-index"     scripts/check-story-index.mjs
run_check "check:repo-hygiene"    scripts/check-repo-hygiene.mjs
# check:story-status compares a doc to its own Tasks; check:story-index catches a
# story with no row. Neither compares the row to the doc, which is how ten rows
# drifted from their own docs unnoticed.
run_check "check:story-parity"    scripts/check-story-status-parity.mjs
# Reads two versions of a story, where check:story-status reads one. A commit
# that unchecks completed tasks or deletes a Dev Agent Record is perfectly
# self-consistent, so the single-version check passes it — which is how story
# 10.3 lost its record on 2026-08-23.
run_check "check:story-regression" scripts/check-story-regression.mjs
run_check "check:role-parity"     scripts/check-role-parity.mjs

# Story 14.1: Firestore is reachable from one module only. The ESLint rule
# says the same thing better, but root `npm run lint` is not part of this
# hook, so that rule is a gate you have to remember to run and this is the
# one that runs itself.
run_check "check:firestore-seam"  scripts/check-firestore-seam.mjs

# Story 14.B: tree-wide, not diff-scoped. The inline-role check inside
# check-story-status only sees files in the commit, so it cannot find a
# violation already present. This reads the whole tree and exempts per line
# rather than per file. 0.06s, so it runs on every commit rather than being
# a periodic job somebody remembers.
run_check "check:role-strings"    scripts/check-role-strings.mjs

# The Angular gate only runs when the commit actually touches web/. It is the
# slowest check here and irrelevant to a backend-only commit.
if git diff --cached --name-only | grep -q '^web/'; then
  if [ ! -d web/node_modules ]; then
    echo "pre-commit: web/node_modules missing — run 'npm ci --prefix web' first." >&2
    exit 1
  fi

  echo "pre-commit: web/ touched, running the Angular gate"
  # The Angular CLI has a Node floor (web/package.json engines, .nvmrc) that
  # common default versions fall below, and older CLI versions abort with no
  # output at all rather than a version error — not a discoverable failure.
  if ! npm --prefix web run build -- --configuration production >/dev/null 2>&1; then
    echo "pre-commit: ng build failed. Run 'npm run web:build' to see why." >&2
    echo "pre-commit: if it exits silently, check your Node version against .nvmrc." >&2
    exit 1
  fi
  npm --prefix web run lint || exit 1
  npm --prefix web run test -- --watch=false || exit 1
fi
