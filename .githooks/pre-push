#!/bin/sh
# tag-agent-hooks v2 — installed into .git/hooks by scripts/install-hooks.mjs.
# Edit this file, not the installed copy, then run: npm run hooks:install
#
# Last line of defence: a session can reach main by pushing from a branch
# without ever checking main out, so the local-branch check cannot see it.
# git feeds the ref list on stdin; the script reads it.
if [ -f scripts/check-main-ownership.mjs ]; then
  node scripts/check-main-ownership.mjs --mode=push || exit 1
fi
