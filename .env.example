# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — real credentials must never be committed.

# ---------------------------------------------------------------------------
# Agency OAuth app (marketplace.gohighlevel.com)
# ---------------------------------------------------------------------------
# Distribution type: Agency. This is what grants access to all sub-accounts
# from a single install. Scopes required:
#   locations.readonly
#   opportunities.readonly, opportunities.write
#   contacts.readonly, contacts.write
#   calendars.readonly, calendars.write
#   calendars/events.readonly, calendars/events.write
#   users.readonly
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ---------------------------------------------------------------------------
# Single-location development fallback (optional once OAuth works)
# ---------------------------------------------------------------------------
# A Private Integration Token reaches exactly one sub-account. Useful for local
# work before the OAuth install exists; not viable at 40+ locations.
GHL_PIT=

# The sub-account (location) ID for the PIT above.
# Visible in the GHL URL: /v2/location/<THIS_PART>/
GHL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=tag-success-hub

# ---------------------------------------------------------------------------
# Identity Platform (Story 1.3)
# ---------------------------------------------------------------------------
# These are public by design — they identify the project, they do not grant
# access to it. Access is decided by Identity Platform and by server-side
# session verification in lib/auth/session.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tag-success-hub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tag-success-hub

# Firebase Admin uses application default credentials: the Cloud Run service
# account in production, `gcloud auth application-default login` locally.
# Only set this in an environment that has neither.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Service account the app signs custom tokens as. Signing goes through the IAM
# signBlob API, so no private key file exists anywhere. Defaults to
# hub-app@<project>.iam.gserviceaccount.com.
# FIREBASE_SERVICE_ACCOUNT_ID=

# Transactional email for six-digit sign-in codes. Unset in development means
# codes are printed to the server console; unset in production is a hard error,
# because silently logging codes would look like it worked while locking
# everyone out.
MAIL_PROVIDER=

# Client-owner dashboard's Slack "cubby" widget. A bot token with
# channels:history and users:read scopes, invited into each client channel it
# needs to read. Unset means the widget shows a not-connected state rather
# than failing.
SLACK_BOT_TOKEN=

# Client-owner dashboard's Documents widget. Both are meant to be public —
# same visibility class as the Firebase web API key — because the actual
# access boundary is Drive's own folder sharing and OAuth consent, not these
# values. Create under APIs & Services > Credentials: a Web application OAuth
# client (authorized JavaScript origins must include the deployed URL and
# localhost), and an API key restricted to the Picker API. Requires the Drive
# API and Picker API enabled on the project. Unset means browsing the linked
# folder still works; only in-Hub upload is disabled.
NEXT_PUBLIC_GOOGLE_PICKER_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# ---------------------------------------------------------------------------
# Meta Marketing API (Story 4.1 / 5.4)
# ---------------------------------------------------------------------------
# Setup sequence: docs/meta-live-launch-plan.md
# Business Portfolio ID — not secret.
META_BUSINESS_ID=

# From the Meta for Developers app (Phase 2). App secret and the System User
# token are real secrets — only ever set in .env.local, never committed.
META_APP_ID=
META_APP_SECRET=
# System User token, not a personal user token — scoped to ads_management,
# ads_read, business_management. Long-lived while the System User exists.
META_SYSTEM_USER_TOKEN=

# Conversions API pixel ID (Story 6.2+). Not secret — safe to expose client-side.
META_PIXEL_ID=

# Shared secret Cloud Scheduler presents as a Bearer token to
# /api/cron/meta-retry (Story 6.5). Required in production — the route
# refuses to run without it.
CRON_SECRET=

# Internal ops channel for Story 6.5's retry-exhausted alert. Distinct from
# the per-client channels in locations/{id}.slackChannelId — this is
# TAG-facing escalation, not something a client should see. Unset means the
# alert is logged to the console instead of Slack.
SLACK_OPS_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Onboarding automation bridge (app -> /functions Cloud Functions)
# ---------------------------------------------------------------------------
# Base URL of the /functions deployment's Express app, e.g.
# https://tag-automation-xyz.run.app in production, http://localhost:8080
# for local /functions dev.
CLOUD_FUNCTIONS_URL=

# Where app/api/onboarding/intake-submit forwards to. Usually
# ${CLOUD_FUNCTIONS_URL}/webhook/phase2 — kept separate since it can point
# at a specific Cloud Function URL instead of the shared Express app.
PHASE2_WEBHOOK_URL=

# Shared secret this app sends as a Bearer token when calling Phase 2 (see
# PHASE2_WEBHOOK_SECRET in functions/.env.example — must match on both
# sides for the receiver's check to mean anything, though it doesn't yet
# block on a mismatch, only warns).
PHASE2_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Postgres (automation logs from /functions)
# ---------------------------------------------------------------------------
# Connection to tag_automation database for reading Phase 1, 2, 3 audit logs.
# Points to the same Postgres instance as /functions.
DB_HOST=localhost
DB_PORT=5432
DB_USER=tag_app_user
DB_PASSWORD=
DB_NAME=tag_automation
