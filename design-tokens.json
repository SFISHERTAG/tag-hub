{
  "colors": {
    "primary": {
      "gold": "#e0a324",
      "gold-secondary": "#cc901b",
      "gold-dark": "#a3730f"
    },
    "semantic": {
      "success": "#1a6b45",
      "success-tint": "#eef7f2",
      "warning": "#be5d1d",
      "danger": "#b02a1f",
      "danger-tint": "#fdf1ef"
    },
    "neutrals": {
      "light": {
        "canvas": "#ffffff",
        "surface": "#f5f5f5",
        "border": "rgb(5 5 5 / 0.2)",
        "ink-primary": "#050505",
        "ink-secondary": "#5c6370",
        "ink-tertiary": "#8b8f99"
      },
      "dark": {
        "canvas": "#0b0a09",
        "surface": "#141311",
        "surface-hover": "#1c1a18",
        "border": "#2a2724",
        "ink-primary": "#f0ede4",
        "ink-secondary": "#a8a49a",
        "ink-tertiary": "#9a958a"
      }
    }
  },
  "typography": {
    "fonts": {
      "system": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
    },
    "scale": {
      "h1": {
        "fontSize": "28px",
        "fontWeight": "600",
        "lineHeight": "1.2"
      },
      "h2": {
        "fontSize": "20px",
        "fontWeight": "600",
        "lineHeight": "1.3"
      },
      "h3": {
        "fontSize": "16px",
        "fontWeight": "600",
        "lineHeight": "1.4"
      },
      "body": {
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      },
      "body-sm": {
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      },
      "label": {
        "fontSize": "12px",
        "fontWeight": "600",
        "lineHeight": "1.5",
        "textTransform": "uppercase",
        "letterSpacing": "0.5px"
      },
      "caption": {
        "fontSize": "11px",
        "fontWeight": "400",
        "lineHeight": "1.5"
      },
      "code": {
        "fontSize": "12px",
        "fontWeight": "600",
        "fontFamily": "monospace"
      }
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "28px",
    "4xl": "32px",
    "5xl": "40px",
    "6xl": "48px",
    "7xl": "56px",
    "8xl": "64px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "50%"
  },
  "shadows": {
    "sm": "0 1px 1px 0 rgb(5 5 5 / 0.03)",
    "md": "0 1px 2px 0 rgb(5 5 5 / 0.1)",
    "lg": "0 1px 2px 0 rgb(0 0 0 / 0.6)",
    "focus": "0 0 0 2px #cc901b"
  },
  "components": {
    "button": {
      "padding": {
        "sm": "6px 12px",
        "md": "8px 16px",
        "lg": "11px 16px"
      },
      "borderRadius": "4px",
      "fontSize": "12px",
      "fontWeight": "600"
    },
    "card": {
      "padding": "20px",
      "borderRadius": "8px",
      "border": "1px solid #2a2724",
      "background": "#141311"
    },
    "input": {
      "padding": "10px 12px",
      "borderRadius": "6px",
      "border": "1px solid #2a2724",
      "fontSize": "14px"
    },
    "badge": {
      "padding": "4px 10px",
      "borderRadius": "12px",
      "fontSize": "11px",
      "fontWeight": "600"
    }
  }
}
