# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Angular build cache. Regenerated by `ng build`/`ng serve`, machine-specific,
# and includes a lock file that is meaningless outside the machine that made it.
# 62 of these were tracked until 2026-08-22; see the commit that added this line.
/.angular/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
database-debug.log*
pubsub-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code memory (personal, not project data)
/.claude/projects/

# typescript
*.tsbuildinfo
next-env.d.ts

# Angular bundle staged into public/ by scripts/stage-angular-bundle.mjs at
# build time. Build output, not source — the source is web/.
/public/index.html
/public/*.js
/public/*.css
/public/media/
/public/icons/
/public/3rdpartylicenses.txt

# bmad installer + renderer output (generated, machine- and worktree-specific)
_bmad/render/
_bmad-output/
*.bak
