# GHL API
GHL_PIT=<private-integration-token-for-template-account>

# Gemini API (for content generation)
GOOGLE_GEMINI_API_KEY=<api-key-from-google-ai-studio>

# Google Cloud
GOOGLE_CLOUD_PROJECT=tag-success-hub

# Google Drive
TAG_SHARED_DRIVE_ID=<shared-drive-id-where-client-folders-go>

# Slack
SLACK_BOT_TOKEN=xoxb-<bot-token-with-channels-manage-scope>

# Email (Gmail SMTP or Gmail API)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@taxadvisorygrowth.com
MAIL_PASS=<app-specific-password>
MAIL_FROM=noreply@taxadvisorygrowth.com

# TAG URLs
HUB_URL=https://hub.taxadvisorygrowth.com
GHL_FORM_URL=https://share.leadconnectorhq.com/forms/<form-id>

# Notifications
TAG_TEAM_EMAIL=team@taxadvisorygrowth.com
