# Postgres Database (for automation logging)
DB_USER=tag_app_user
DB_PASSWORD=tag_automation_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tag_automation

# Cloud Functions
CLOUD_FUNCTIONS_URL=http://localhost:8080

# Shared secrets the app sends as a Bearer token on its webhook calls here
# (see PHASE2_WEBHOOK_SECRET in the app's own .env.example — must match).
# Checked but not enforced yet: a missing or mismatched token only logs a
# warning, it doesn't reject the request. PHASE3_WEBHOOK_SECRET has no
# sender configured on the app side yet — expect that warning until it does.
PHASE2_WEBHOOK_SECRET=
PHASE3_WEBHOOK_SECRET=

# Meta API
META_BUSINESS_ID=your_business_id
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_SYSTEM_USER_TOKEN=your_system_user_token
META_SYSTEM_USER_ID=100001234567890
META_SETUP_GUIDE_URL=https://facebook.com/ads/manager/setup

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@taxadvisorygrowth.com

# Team
TAG_TEAM_EMAIL=team@taxadvisorygrowth.net
GHL_FORM_URL=https://your-form-url.com

# Environment
NODE_ENV=development
PORT=8080
