# Postgres Database (for automation logging)
DB_USER=tag_app_user
DB_PASSWORD=tag_automation_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tag_automation

# Cloud Functions
CLOUD_FUNCTIONS_URL=http://localhost:8080

# Shared secrets callers send as a Bearer token on their webhook calls here
# (see the matching names in the app's own .env.example — the values must
# match on both sides).
#
# PHASE1_WEBHOOK_SECRET is ENFORCED: a missing, mismatched, or unconfigured
# secret rejects the request. Phase 1 writes the caller-supplied contact
# email into the OTP whitelist, so an unauthenticated call grants a working
# login, not just resources. Set this on the function and set the same value
# as the bearer token on the GHL "Initiate Onboarding" webhook. Deploying
# without it takes Phase 1 offline (500) rather than leaving it open.
#
# PHASE2/PHASE3 are checked but not enforced: a missing or mismatched token
# only logs a warning. Those endpoints provision against an already-created
# tenant and do not grant access, and their callers' rollout isn't fully
# controlled here.
PHASE1_WEBHOOK_SECRET=
PHASE2_WEBHOOK_SECRET=
PHASE3_WEBHOOK_SECRET=

# Meta API
META_BUSINESS_ID=your_business_id
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_SYSTEM_USER_TOKEN=your_system_user_token
META_SYSTEM_USER_ID=100001234567890
META_SETUP_GUIDE_URL=https://facebook.com/ads/manager/setup

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@taxadvisorygrowth.com

# Team
TAG_TEAM_EMAIL=team@taxadvisorygrowth.net
GHL_FORM_URL=https://your-form-url.com

# Environment
NODE_ENV=development
PORT=8080

# --- Read by the code but previously absent from this template ---
# Credentials: these live in Secret Manager and are attached by the deploy
# scripts, not set here. Listed so the requirement is discoverable.
GHL_PIT=
SLACK_BOT_TOKEN=
GOOGLE_GEMINI_API_KEY=
META_SYSTEM_USER_TOKEN=

# Configuration:
TAG_SHARED_DRIVE_ID=
GOOGLE_CLOUD_PROJECT=
PHASE3_WEBHOOK_URL=
