{
  "name": "tag-automation-functions",
  "version": "1.0.0",
  "description": "TAG client onboarding automation \u2014 Cloud Functions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "deploy": "npm run deploy:phase1 && npm run deploy:phase2 && npm run deploy:phase3",
    "deploy:phase1": "gcloud functions deploy phase1-provisioning --gen2 --region=us-central1 --runtime=nodejs22 --trigger-http --allow-unauthenticated --entry-point=phase1Provisioning --update-secrets=PHASE1_WEBHOOK_SECRET=phase1-webhook-secret:latest,GHL_PIT=ghl-pit:latest,SLACK_BOT_TOKEN=slack-bot-token:latest",
    "deploy:phase2": "gcloud functions deploy phase2-intake-submit --gen2 --region=us-central1 --runtime=nodejs22 --trigger-http --allow-unauthenticated --entry-point=phase2IntakeSubmit --update-secrets=PHASE2_WEBHOOK_SECRET=phase2-webhook-secret:latest,GHL_PIT=ghl-pit:latest,GOOGLE_GEMINI_API_KEY=gemini-api-key:latest",
    "deploy:phase3": "gcloud functions deploy phase3-meta-setup --gen2 --region=us-central1 --runtime=nodejs22 --trigger-http --allow-unauthenticated --entry-point=phase3MetaSetup --update-secrets=PHASE3_WEBHOOK_SECRET=phase3-webhook-secret:latest,META_SYSTEM_USER_TOKEN=meta-system-user-token:latest"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google/genai": "^2.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.14",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^140.0.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.23.0",
    "typescript": "^5.5.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0"
  }
}
