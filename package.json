{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run web:build && node scripts/stage-angular-bundle.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:story-status": "node scripts/check-story-status.mjs",
    "check:story-regression": "node scripts/check-story-regression.mjs",
    "check:agent-isolation": "node scripts/check-agent-isolation.mjs",
    "check:main-ownership": "node scripts/check-main-ownership.mjs",
    "check:branch-freshness": "node scripts/check-branch-freshness.mjs",
    "check:secret-scan": "node scripts/check-secret-scan.mjs",
    "check:role-parity": "node scripts/check-role-parity.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "web:build": "npm --prefix web run build -- --configuration production",
    "web:lint": "npm --prefix web run lint",
    "web:test": "npm --prefix web run test -- --watch=false",
    "web:gate": "npm run web:build && npm run web:lint && npm run web:test",
    "check:functions": "npm --prefix functions run build && npm --prefix functions run lint",
    "check:migrations": "tsx scripts/check-migrations.mjs",
    "prepare": "node scripts/install-hooks.mjs || true",
    "build:next-only": "next build"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^174.0.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/facebook-nodejs-business-sdk": "^24.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
